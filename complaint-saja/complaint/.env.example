# Complaint Management System - Environment Configuration
# This file should be kept secret and never committed to version control

# Secret key for Flask session encryption (generate a random string)
# You can generate one using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-change-this

# Admin login credentials
# WARNING: Change these on production deployments immediately!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=test123

# Database configuration (optional)
# DATABASE_PATH=complaints.db

# Flask configuration (optional)
# FLASK_ENV=development
# FLASK_DEBUG=False  # Set to True only in development

# Session configuration (optional)
# SESSION_TIMEOUT_MINUTES=720  # 12 hours default
